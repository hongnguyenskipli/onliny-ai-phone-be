{
  "info": {
    "name": "Onliny AI Phone API",
    "description": "API collection for Onliny AI Phone backend - Authentication (OTP) and Business CRD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token returned from verify-otp. Auto-set by the verify-otp test script."
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "send-otp"]
            },
            "description": "Send a 6-digit OTP to the provided email address via AWS SES. OTP expires in 10 minutes."
          },
          "response": [
            {
              "name": "200 - OTP Sent",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"OTP sent to your email.\"\n}"
            },
            {
              "name": "400 - Invalid Email",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"A valid email is required.\"\n}"
            },
            {
              "name": "500 - Server Error",
              "status": "Internal Server Error",
              "code": 500,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Failed to send OTP. Please try again.\"\n}"
            }
          ]
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('JWT token saved to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            },
            "description": "Verify the OTP sent to email. Returns a JWT token valid for 7 days. The test script auto-saves the token to the `token` collection variable."
          },
          "response": [
            {
              "name": "200 - Verified",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            },
            {
              "name": "400 - Invalid OTP",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Invalid OTP.\"\n}"
            },
            {
              "name": "400 - OTP Expired",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"OTP has expired. Please request a new one.\"\n}"
            },
            {
              "name": "400 - OTP Not Found",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"OTP not found. Please request a new one.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Business",
      "item": [
        {
          "name": "Create Business",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Awesome Business\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/business",
              "host": ["{{baseUrl}}"],
              "path": ["api", "business"]
            },
            "description": "Create a new business name. Requires JWT token in Authorization header. The business is tied to the authenticated user's email."
          },
          "response": [
            {
              "name": "201 - Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"business\": {\n    \"id\": \"abc123xyz\",\n    \"name\": \"My Awesome Business\",\n    \"ownerEmail\": \"user@example.com\",\n    \"createdAt\": \"2024-01-15T10:30:00.000Z\"\n  }\n}"
            },
            {
              "name": "400 - Missing Name",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Business name is required.\"\n}"
            },
            {
              "name": "401 - Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Unauthorized: Missing token.\"\n}"
            }
          ]
        },
        {
          "name": "Get Businesses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/business",
              "host": ["{{baseUrl}}"],
              "path": ["api", "business"]
            },
            "description": "Get all businesses owned by the authenticated user. Sorted by creation date descending."
          },
          "response": [
            {
              "name": "200 - Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"businesses\": [\n    {\n      \"id\": \"abc123xyz\",\n      \"name\": \"My Awesome Business\",\n      \"ownerEmail\": \"user@example.com\",\n      \"createdAt\": \"2024-01-15T10:30:00.000Z\"\n    },\n    {\n      \"id\": \"def456uvw\",\n      \"name\": \"Second Business\",\n      \"ownerEmail\": \"user@example.com\",\n      \"createdAt\": \"2024-01-10T08:00:00.000Z\"\n    }\n  ]\n}"
            },
            {
              "name": "401 - Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Unauthorized: Missing token.\"\n}"
            }
          ]
        },
        {
          "name": "Delete Business",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/business/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "business", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "abc123xyz",
                  "description": "The business ID to delete"
                }
              ]
            },
            "description": "Delete a business by ID. Only the owner of the business can delete it."
          },
          "response": [
            {
              "name": "200 - Deleted",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true\n}"
            },
            {
              "name": "403 - Forbidden",
              "status": "Forbidden",
              "code": 403,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Forbidden: You do not own this business.\"\n}"
            },
            {
              "name": "404 - Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Business not found.\"\n}"
            },
            {
              "name": "401 - Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Unauthorized: Missing token.\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
